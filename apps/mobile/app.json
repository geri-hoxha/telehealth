{
  "expo": {
    "name": "Telehealth",
    "slug": "telehealth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "al.telehealth.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "al.telehealth.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Telehealth përdor kamerën për videothirrjet me mjekun.",
          "microphonePermission": "Telehealth përdor mikrofonin për thirrjet me mjekun."
        }
      ],
      [
        "expo-callkit-telecom",
        {
          "cameraPermission": "Telehealth përdor kamerën për videothirrjet me mjekun.",
          "microphonePermission": "Telehealth përdor mikrofonin për thirrjet me mjekun.",
          "incomingCallTimeout": 40,
          "outgoingCallTimeout": 60,
          "includesCallsInRecents": false
        }
      ]
    ],
    "scheme": "telehealth",
    "experiments": {
      "typedRoutes": true
    }
  }
}
