{
  "expo": {
    "name": "Telehealth",
    "slug": "telehealth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "al.telehealth.app",
      "appleTeamId": "D2687NLBYF",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "sq",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "al.telehealth.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Telehealth përdor Face ID që të hyni pa fjalëkalim."
        }
      ],
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Telehealth përdor kamerën për videothirrjet me mjekun.",
          "microphonePermission": "Telehealth përdor mikrofonin për thirrjet me mjekun."
        }
      ],
      [
        "expo-callkit-telecom",
        {
          "cameraPermission": "Telehealth përdor kamerën për videothirrjet me mjekun.",
          "microphonePermission": "Telehealth përdor mikrofonin për thirrjet me mjekun.",
          "incomingCallTimeout": 40,
          "outgoingCallTimeout": 360,
          "includesCallsInRecents": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Telehealth përdor fotot tuaja për foton e profilit dhe për dokumentet mjekësore.",
          "cameraPermission": "Telehealth përdor kamerën për videothirrjet, foton e profilit dhe dokumentet mjekësore.",
          "microphonePermission": "Telehealth përdor mikrofonin për thirrjet me mjekun."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Telehealth përdor Face ID që të hyni pa fjalëkalim."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0D9488"
        }
      ]
    ],
    "scheme": "telehealth",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55fff5ad-8a28-4da2-a2d2-ea2fb53aef0e"
      }
    },
    "locales": {
      "sq": "./locales/sq.json",
      "en": "./locales/en.json",
      "mk": "./locales/mk.json"
    }
  }
}
