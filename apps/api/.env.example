DATABASE_URL=postgresql://postgres:<password>@localhost:5432/telehealth?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
PORT=3000

# LiveKit: https://cloud.livekit.io → your project → Settings → API keys (free "Build" plan).
# A self-hosted LiveKit server works the same way: use its URL and keys instead.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# How long the doctor's phone rings before the call counts as unanswered.
# Keep incomingCallTimeout of expo-callkit-telecom in apps/mobile/app.json a few seconds shorter:
# the phone starts counting when the push arrives, which is a little after the call starts.
CALL_RING_SECONDS=45

# How long a patient may wait in the queue before the call ends as "lines busy".
# Keep outgoingCallTimeout of expo-callkit-telecom in apps/mobile/app.json longer than this plus
# CALL_RING_SECONDS, or the patient's phone ends the call first.
CALL_MAX_WAIT_SECONDS=300

# The address links in emails point to (the email confirmation link).
PUBLIC_API_URL=http://localhost:3000

# Emails (sign-up confirmation, password reset codes) go through Resend (https://resend.com).
# Leave empty in development: the emails, with their links and codes, are written to the API's log.
RESEND_API_KEY=
MAIL_FROM=Telehealth <no-reply@your-domain.al>

# "Call assistance" in the app's profile dials this number. The app says it isn't set up while empty.
SUPPORT_PHONE=

# The partner clinic network the app opens. Empty: the API's own sample page (/api/pages/partners).
PARTNER_NETWORK_URL=

# Where uploaded profile photos and medical documents are stored.
UPLOADS_DIR=./uploads

# iOS ringing (VoIP push through APNs). Apple Developer → Keys → a key with "Apple Push Notifications service (APNs)".
# Leave empty to skip: an iPhone then only rings while the app is open.
APNS_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=al.telehealth.app
# false for development builds (sandbox APNs), true for TestFlight / App Store builds
APNS_PRODUCTION=false

# Android ringing (FCM). Firebase console → Project settings → Service accounts → Generate new private key.
# Leave empty to skip: an Android phone then only rings while the app is open.
FCM_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
